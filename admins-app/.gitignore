# OneSignal keys (VERY IMPORTANT - keep secret)
# ONESIGNAL_REST_API_KEY is secret - NEVER commit
# ONESIGNAL_APP_ID can be in .env.example (it's public in app builds anyway)
.env
.env.local
.env.production
.env.*.local
