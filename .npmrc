# NPM Configuration for stable installations
# Location: ~/.npmrc or project root

# Network stability settings
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=120000

# Registry
registry=https://registry.npmjs.org/

# SSL settings (disable for corporate proxies if needed)
strict-ssl=false

# Peer dependencies
legacy-peer-deps=true

# Progress bar (disable for faster installs)
progress=false

# Log level
loglevel=warn

# Max sockets
maxsockets=50
