# ======================================
# ENVIRONMENT VARIABLES TEMPLATE
# ======================================
# ⚠️ IMPORTANT: 
# 1. Copy this file to .env
# 2. Fill in your actual values
# 3. NEVER commit .env to git!
# ======================================

# --------------------------------------
# Supabase Configuration (Client-side)
# --------------------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# --------------------------------------
# Map Services
# --------------------------------------
# Get MapTiler key from: https://www.maptiler.com/account/
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Get LocationIQ token from: https://locationiq.com/keys
EXPO_PUBLIC_LOCATION_IQ_TOKEN=your_locationiq_token_here

# --------------------------------------
# Admin Configuration (for admin app)
# --------------------------------------
EXPO_PUBLIC_ADMIN_EMAIL=your_admin_email_here

# --------------------------------------
# Expo Configuration
# --------------------------------------
# Set to 1 to skip Expo Doctor checks
EXPO_NO_DOCTOR=1

# ======================================
# ONE SIGNAL CONFIGURATION
# ======================================
# Get App IDs and REST API Keys from: https://onesignal.com/
# Each app has its own OneSignal app

# USER APP
# ONESIGNAL_USERAPP_KEY=your_userapp_rest_api_key_here

# DELIVERY APP  
# ONESIGNAL_DELIVERAP_KEY=your_deliverapp_rest_api_key_here

# ADMIN APP
# ONESIGNAL_ADMINSAPP_KEY=your_adminsapp_rest_api_key_here

# ======================================
# SUPABASE EDGE FUNCTION SECRETS
# ======================================
# These are set in Supabase Dashboard → Edge Functions → [function-name] → Secrets
# DO NOT add them to .env file!
#
# Required secrets for send-onesignal-notification function:
# - ONESIGNAL_USERAPP_KEY
# - ONESIGNAL_DELIVERAP_KEY  
# - ONESIGNAL_ADMINSAPP_KEY
# - ADMIN_EMAIL
# ======================================
