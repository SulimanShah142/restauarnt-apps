{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "resourceClass": "default",
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "channel": "production"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "resourceClass": "default",
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease",
        "image": "latest"
      },
      "ios": {
        "distribution": "internal"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "resourceClass": "default",
        "buildType": "apk"
      },
      "ios": {
        "distribution": "store"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        
      }
    }
  }
}
